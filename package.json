{
  "name": "makeathon",
  "version": "0.1.0",
  "private": true,
  "description": "The TUM.ai Makeathon website: 48 hours of AI in Munich.",
  "homepage": "https://makeathon.tum-ai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tum-ai/makeathon.git"
  },
  "bugs": {
    "url": "https://github.com/tum-ai/makeathon/issues"
  },
  "license": "UNLICENSED",
  "author": "TUM.ai",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3130",
    "build": "next build",
    "postbuild": "node scripts/check-kit-css.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project dom",
    "test:coverage": "vitest run --project unit --project dom --coverage",
    "test:e2e": "playwright test",
    "perf": "node scripts/perf.mjs",
    "verify": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run test:e2e",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tum.ai/ui-kit": "0.3.1",
    "clsx": "2.1.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
